{
  "id": "reposicionInsumos01",
  "name": "Flujo 2 - Reposición de insumos (nocturno)",
  "nodes": [
    {
      "id": "cron",
      "name": "Cada noche 23:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 23 * * *" }] } }
    },
    {
      "id": "consultar",
      "name": "¿Hay insumos que reponer?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "jsCode": "// El borrador lo calcula menu-inventario-service. Sin stock bajo el flujo termina aquí.\nconst lineas = await this.helpers.httpRequest({ url: `${$env.MENU_URL}/insumos/orden-compra-borrador`, json: true });\nreturn lineas.length ? [{ json: { objetivo: 'Reposición nocturna de insumos', contexto: { automatico: true } } }] : [];"
      }
    },
    {
      "id": "proponer",
      "name": "Pedir aprobación al administrador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.IA_URL + '/agentes/inventario-compras' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 120000 }
      }
    }
  ],
  "connections": {
    "Cada noche 23:00": { "main": [[{ "node": "¿Hay insumos que reponer?", "type": "main", "index": 0 }]] },
    "¿Hay insumos que reponer?": { "main": [[{ "node": "Pedir aprobación al administrador", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
