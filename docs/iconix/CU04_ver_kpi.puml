@startuml Secuencia_Ver_KPI
title Diagrama de Secuencia - CU04: Ver KPI

hide footbox
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #2C6CA5
  ParticipantBorderColor #2C6CA5
  ParticipantBackgroundColor #E8F4FD
  ActorBorderColor #2C3E50
}

actor "Administrador" as Adm
boundary "Vista\n(BI)" as Vista
participant "Gateway\n(api-gw)" as GW
control "PrediccionesRouter\n(MSIA)" as IA
database "BD Agentes\n(SQLite)" as Sql
participant "AnaliticaController\n(MSReservas)" as Anal
participant "EstudiantesController\n(MSReservas)" as EstC
database "BD Reservas\n(PostgreSQL)" as PgRes
participant "PagosController\n(MSPagos)" as Pag
database "BD Pagos\n(PostgreSQL)" as PgPag
participant "MenuController\n(MSMenu)" as Ctrl
participant "InsumoController\n(MSMenu)" as Ins
database "BD Menu\n(MongoDB)" as Mongo

== Endpoint: GET /ml/kpis ==

Adm -> Vista : abrir KPI
activate Vista
Vista -> GW : GET /ml/kpis
activate GW
GW -> GW : requireAuth(token)
GW -> IA : indicadores()
activate IA
IA -> IA : kpis.calcular()

IA -> IA : KPI 1: _ocupacion(hoy)
IA -> Ctrl : historial(desde, hasta)
activate Ctrl
Ctrl -> Mongo : find({fecha: {$gte: desde, $lte: hasta}})
activate Mongo
Mongo --> Ctrl : menus
deactivate Mongo
Ctrl --> IA : menús con cupo y apartadas
deactivate Ctrl

IA -> IA : KPI 2: _ingresos(hoy)
IA -> Pag : listar()
activate Pag
Pag -> PgPag : SELECT * FROM pagos
activate PgPag
PgPag --> Pag : pagos
deactivate PgPag
Pag --> IA : pagos
deactivate Pag

IA -> IA : KPI 3: _volumen(hoy)
IA -> Anal : listarReservas()
activate Anal
Anal -> PgRes : SELECT * FROM reservas
activate PgRes
PgRes --> Anal : reservas
deactivate PgRes
Anal --> IA : reservas
deactivate Anal

IA -> IA : KPI 4: _cancelacion()

IA -> IA : KPI 5: _becas()
IA -> Anal : listarBecas()
activate Anal
Anal -> PgRes : SELECT * FROM becas
activate PgRes
PgRes --> Anal : becas
deactivate PgRes
Anal --> IA : becas
deactivate Anal
IA -> EstC : listar()
activate EstC
EstC -> PgRes : SELECT * FROM estudiantes
activate PgRes
PgRes --> EstC : estudiantes
deactivate PgRes
EstC --> IA : estudiantes
deactivate EstC

IA -> IA : KPI 6: _desperdicio()
IA -> Sql : todas_las_bandejas()
activate Sql
Sql --> IA : bandejas
deactivate Sql

IA -> IA : KPI 7: _insumos()
IA -> Ins : listar()
activate Ins
Ins -> Mongo : find({})
activate Mongo
Mongo --> Ins : insumos
deactivate Mongo
Ins --> IA : insumos
deactivate Ins

IA -> IA : _registros()
IA --> GW : { generado, kpis, registros }
deactivate IA
GW --> Vista : 200 OK
deactivate GW
Vista --> Adm : muestra los 7 KPI con su estado y gráfico
deactivate Vista

@enduml
