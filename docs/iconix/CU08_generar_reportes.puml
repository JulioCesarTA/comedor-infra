@startuml Secuencia_Generar_Reportes
title Diagrama de Secuencia - CU08: Generar reportes

hide footbox
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #2C6CA5
  ParticipantBorderColor #2C6CA5
  ParticipantBackgroundColor #E8F4FD
  ActorBorderColor #2C3E50
}

actor "Administrador" as Adm
boundary "Vista\n(BI)" as Vista
database "BD Local\n(IndexedDB)" as Local
participant "Gateway\n(api-gw)" as GW
control "ReportesRouter\n(MSIA)" as IA
participant "AnaliticaController\n(MSReservas)" as Anal
participant "EstudiantesController\n(MSReservas)" as EstC
database "BD Reservas\n(PostgreSQL)" as PgRes
participant "PagosController\n(MSPagos)" as Pag
database "BD Pagos\n(PostgreSQL)" as PgPag
participant "MenuController\n(MSMenu)" as Ctrl
participant "InsumoController\n(MSMenu)" as Ins
database "BD Menu\n(MongoDB)" as Mongo
database "BD Agentes\n(SQLite)" as Sql

== Endpoint: GET /reportes/snapshot (copia de datos para trabajar sin internet) ==

Adm -> Vista : abrir Reportes
activate Vista
Vista -> Local : leerGuardado("snapshot")
activate Local
Local --> Vista : copia guardada
deactivate Local

opt no hay copia o tiene más de 15 minutos, y hay internet
  Vista -> GW : GET /reportes/snapshot
  activate GW
  GW -> GW : requireAuth(token)
  GW -> IA : get_snapshot(roles)
  activate IA
  IA -> IA : snapshot.construir(roles)
    IA -> Anal : listarReservas()
    activate Anal
    Anal -> PgRes : SELECT * FROM reservas
    activate PgRes
    PgRes --> Anal : reservas
    deactivate PgRes
    Anal --> IA : reservas
    deactivate Anal
    IA -> Pag : listar()
    activate Pag
    Pag -> PgPag : SELECT * FROM pagos
    activate PgPag
    PgPag --> Pag : pagos
    deactivate PgPag
    Pag --> IA : pagos
    deactivate Pag
    IA -> EstC : listar()
    activate EstC
    EstC -> PgRes : SELECT * FROM estudiantes
    activate PgRes
    PgRes --> EstC : estudiantes
    deactivate PgRes
    EstC --> IA : estudiantes
    deactivate EstC
    IA -> Anal : listarBecas()
    activate Anal
    Anal -> PgRes : SELECT * FROM becas
    activate PgRes
    PgRes --> Anal : becas
    deactivate PgRes
    Anal --> IA : becas
    deactivate Anal
    IA -> Ctrl : historial(desde, hasta)
    activate Ctrl
    Ctrl -> Mongo : find({fecha: {$gte: desde, $lte: hasta}})
    activate Mongo
    Mongo --> Ctrl : menus
    deactivate Mongo
    Ctrl --> IA : menús
    deactivate Ctrl
    IA -> Ins : listar()
    activate Ins
    Ins -> Mongo : find({})
    activate Mongo
    Mongo --> Ins : insumos
    deactivate Mongo
    Ins --> IA : insumos
    deactivate Ins
    IA -> Sql : todas_las_bandejas()
    activate Sql
    Sql --> IA : bandejas
    deactivate Sql
    IA -> Anal : listarAsistencia()
    activate Anal
    Anal -> PgRes : SELECT * FROM asistencias
    activate PgRes
    PgRes --> Anal : marcas
    deactivate PgRes
    Anal --> IA : asistencia
    deactivate Anal
  IA --> GW : { datasets, catalogo, generado }
  deactivate IA
  GW --> Vista : 200 OK
  deactivate GW
  Vista -> Local : guardar("snapshot", copia)
  activate Local
  deactivate Local
end
Vista --> Adm : muestra "IA local, datos del ..."
deactivate Vista

== Generar el reporte (en el navegador, sin llamar al servidor) ==

Adm -> Vista : generar(texto o voz)
activate Vista
Vista -> Vista : lenguaje.interpretar(texto, previa, tablas)
Vista -> Vista : motor.ejecutar(spec, tablas)
Vista -> Local : guardar("ultimo", reporte)
activate Local
deactivate Local
Vista --> Adm : muestra tabla, gráfico y resumen
deactivate Vista

Adm -> Vista : bajar(reporte, "pdf" o "excel")
activate Vista
Vista -> Vista : exportar(reporte, formato)
Vista --> Adm : descarga el archivo
deactivate Vista

@enduml
