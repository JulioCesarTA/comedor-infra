@startuml Secuencia_Controlar_Inventario
title Diagrama de Secuencia - CU03: Controlar inventario y reponer insumos

hide footbox
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #2C6CA5
  ParticipantBorderColor #2C6CA5
  ParticipantBackgroundColor #E8F4FD
  ActorBorderColor #2C3E50
}

actor "Administrador" as Adm
boundary "Vista\n(Backoffice)" as Vista
participant "Gateway\n(api-gw)" as GW
participant "Gateway\n(graphql-gw)" as GQL
control "AgentesRouter\n(MSIA)" as IA
database "BD Agentes\n(SQLite)" as Sql
participant "Automatización\n(n8n)" as N8n
participant "Notificaciones\n(FCM)" as FCM
participant "Notificaciones\n(Telegram)" as Tg
participant "McpController\n(MSMenu)" as Mcp
participant "MenuGraphqlController\n(MSMenu)" as Subgrafo
participant "ProveedoresController\n(MSPagos)" as Prov
database "BD Menu\n(MongoDB)" as Mongo
database "BD Pagos\n(PostgreSQL)" as PgPag

== Endpoint 1: POST /agentes/inventario-compras (también lo dispara n8n cada noche) ==

Adm -> Vista : correr("inventario-compras")
activate Vista
Vista -> GW : POST /agentes/inventario-compras
activate GW
GW -> GW : requireAuth(token)
GW -> IA : inv(mision)
activate IA
IA -> IA : InventarioComprasAgent.run(objetivo)

IA -> Mcp : crear_orden_compra_borrador()
activate Mcp
Mcp -> Mongo : find({stockBajo: true})
activate Mongo
Mongo --> Mcp : insumos
deactivate Mongo
Mcp --> IA : líneas del borrador (stock bajo)
deactivate Mcp

IA -> Mcp : lotes_por_vencer(dias=7)
activate Mcp
Mcp -> Mongo : find({vencimiento: {$lte: fecha}})
activate Mongo
Mongo --> Mcp : insumos
deactivate Mongo
Mcp --> IA : lotes por vencer
deactivate Mcp

IA -> IA : agrega precio, proveedor y severidad
IA -> IA : proponer_inventario(resultado)
IA -> Sql : crear_si_no_hay_vigente(propuesta)
activate Sql
Sql --> IA : propuesta PENDIENTE
deactivate Sql
IA -> N8n : POST /webhook/notificar(push, "Inventario: alerta")
activate N8n
N8n -> FCM : messages:send(token, titulo, cuerpo)
activate FCM
FCM --> N8n : enviado
deactivate FCM
N8n --> IA : { ok: true }
deactivate N8n
IA -> Sql : encolar(mensajeAdmin, propuestaId)
activate Sql
deactivate Sql
IA -> N8n : POST /webhook/notificar(telegram, mensajeAdmin)
activate N8n
N8n -> Tg : sendMessage(chat, mensajeAdmin, botones aprobar / rechazar)
activate Tg
Tg --> N8n : enviado
deactivate Tg
N8n --> IA : { ok: true }
deactivate N8n
IA --> GW : { severidad, ordenesBorrador, propuestaCompra }
deactivate IA
GW --> Vista : 200 OK
deactivate GW
Vista --> Adm : muestra la orden de compra propuesta
deactivate Vista

== Endpoint 2: POST /agentes/propuestas/{id}/aprobar ==

Adm -> Vista : resolver(propuesta, aprobar = true)
activate Vista
Vista -> GW : POST /agentes/propuestas/{id}/aprobar
activate GW
GW -> GW : requireAuth(token)
GW -> IA : aprobar(id)
activate IA
IA -> IA : propuestas.resolver(id, aprobar)
IA -> Sql : tomar_pendiente(id, EJECUTANDO)
activate Sql
Sql --> IA : ok
deactivate Sql
IA -> IA : _ejecutar_compra(payload, id)
IA -> N8n : POST /webhook/orden-aprobada(ordenId, proveedores)
activate N8n
loop por cada proveedor
  N8n -> Prov : POST /proveedores/pagos(ordenId, proveedor, monto, detalle)
  activate Prov
  Prov -> Prov : ObligacionesProveedorService.registrar(...)
  Prov -> PgPag : INSERT INTO obligaciones_proveedor
  activate PgPag
  PgPag --> Prov : obligacion PENDIENTE
  deactivate PgPag
  Prov --> N8n : 201 Created
  deactivate Prov
end
N8n --> IA : { ok: true, registradas }
deactivate N8n
IA -> Sql : cerrar(id, EJECUTADA)
activate Sql
deactivate Sql
IA -> Sql : encolar(orden aprobada y resultado)
activate Sql
deactivate Sql
IA -> N8n : POST /webhook/notificar(telegram, orden aprobada)
activate N8n
N8n -> Tg : sendMessage(chat, orden aprobada y resultado)
activate Tg
Tg --> N8n : enviado
deactivate Tg
N8n --> IA : { ok: true }
deactivate N8n
IA --> GW : { estado: EJECUTADA, resultado }
deactivate IA
GW --> Vista : 200 OK
deactivate GW
Vista --> Adm : muestra la orden aprobada
deactivate Vista

== Endpoint 3: POST /graphql (mutation registrarLote) ==

Adm -> Vista : recibirLote(insumo, cantidad, vence)
activate Vista
Vista -> GW : POST /graphql
activate GW
GW -> GW : requireAuth(token)
GW -> GQL : mutation registrarLote(insumoId, loteId, cantidad, unidad, vence)
activate GQL
GQL -> Subgrafo : registrarLote(insumoId, loteId, cantidad, unidad, vence)
activate Subgrafo
Subgrafo -> Subgrafo : RegistrarLoteUseCase.ejecutar(entrada)
Subgrafo -> Mongo : findOne({id: insumoId})
activate Mongo
Mongo --> Subgrafo : insumo
deactivate Mongo
Subgrafo -> Subgrafo : insumo.registrarLote(lote)
Subgrafo -> Mongo : updateOne({_id: insumoId}, {$push: {lotes: lote}})
activate Mongo
Mongo --> Subgrafo : insumo
deactivate Mongo
Subgrafo --> GQL : { ok: true, insumoId, loteId }
deactivate Subgrafo
GQL --> GW : { data: { registrarLote } }
deactivate GQL
GW --> Vista : 200 OK
deactivate GW
Vista --> Adm : muestra "Lote registrado"
deactivate Vista

@enduml
