@startuml Secuencia_Consultar_Reservar_Telegram
title Diagrama de Secuencia - CU10: Consultar y reservar por Telegram

hide footbox
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #2C6CA5
  ParticipantBorderColor #2C6CA5
  ParticipantBackgroundColor #E8F4FD
  ActorBorderColor #2C3E50
}

actor "Estudiante" as Est
boundary "Vista\n(Telegram)" as Tg
participant "Automatización\n(n8n)" as N8n
control "AgentesRouter\n(MSIA)" as IA
control "SagaOrchestrator\n(MSIA)" as Saga
database "BD Agentes\n(SQLite)" as Sql
database "BD Sagas\n(DynamoDB)" as Dynamo
participant "Identidad\n(Keycloak)" as Kc
participant "McpController\n(MSMenu)" as McpM
participant "PorcionesController\n(MSMenu)" as Por
database "BD Menu\n(MongoDB)" as Mongo
participant "McpController\n(MSReservas)" as McpR
participant "ReservasController\n(MSReservas)" as Res
database "BD Reservas\n(PostgreSQL)" as PgRes
participant "PagosController\n(MSPagos)" as Pag
database "BD Pagos\n(PostgreSQL)" as PgPag
participant "Pasarela\n(Stripe)" as Stripe

== Identificarse: POST /agentes/telegram/evento ==

Est -> Tg : /start
activate Tg
N8n -> Tg : getUpdates(offset) (cada 10 segundos)
activate N8n
Tg --> N8n : update
N8n -> IA : telegram_evento(update)
activate IA
IA -> IA : procesar_evento(update)
IA -> Sql : chat(cid)
activate Sql
Sql --> IA : sin vincular
deactivate Sql
IA -> IA : _pedir_correo(cid)
IA -> Sql : guardar_chat(cid, pide_email)
activate Sql
deactivate Sql
IA --> N8n : { acciones: [sendMessage] }
deactivate IA
N8n -> Tg : sendMessage(chat, pide el correo)
deactivate N8n
Tg --> Est : pide el correo institucional
deactivate Tg

Est -> Tg : escribe su correo
activate Tg
N8n -> Tg : getUpdates(offset)
activate N8n
Tg --> N8n : update
N8n -> IA : telegram_evento(update)
activate IA
IA -> IA : procesar_evento(update)
IA -> Sql : chat(cid)
activate Sql
Sql --> IA : pide_email
deactivate Sql
IA -> IA : _recibir_correo(cid, correo)
IA -> Kc : usuario_por_email(correo)
activate Kc
Kc --> IA : { username, nombre, roles }
deactivate Kc
IA -> IA : _vincular(cid, usuario)
IA -> Sql : guardar_chat(cid, listo, roles)
activate Sql
deactivate Sql
IA --> N8n : { acciones: [sendMessage] }
deactivate IA
N8n -> Tg : sendMessage(chat, menú principal con botones)
deactivate N8n
Tg --> Est : muestra Menú, Quién soy y Reservar
deactivate Tg

== Consultar el menú: POST /agentes/telegram/evento ==

Est -> Tg : pulsa "Menú"
activate Tg
N8n -> Tg : getUpdates(offset)
activate N8n
Tg --> N8n : update
N8n -> IA : telegram_evento(update)
activate IA
IA -> IA : procesar_evento(update)
IA -> Sql : chat(cid)
activate Sql
Sql --> IA : listo
deactivate Sql
IA -> IA : _ver_menu(cid, turno)
IA -> McpM : consultar_menu(turno)
activate McpM
McpM -> Mongo : find({fecha: {$gte: inicio}, turno})
activate Mongo
Mongo --> McpM : menus
deactivate Mongo
McpM --> IA : menús con porciones disponibles
deactivate McpM
IA --> N8n : { acciones: [answerCallbackQuery, sendMessage] }
deactivate IA
N8n -> Tg : sendMessage(chat, menú por día)
deactivate N8n
Tg --> Est : muestra el menú y los cupos
deactivate Tg

== Elegir turno, día y plato: POST /agentes/telegram/evento ==

Est -> Tg : pulsa "Reservar"
activate Tg
N8n -> Tg : getUpdates(offset)
activate N8n
Tg --> N8n : update
N8n -> IA : telegram_evento(update)
activate IA
IA -> IA : procesar_evento(update)
IA -> Sql : chat(cid)
activate Sql
Sql --> IA : listo
deactivate Sql
IA -> IA : _elegir_turno(cid, chat)
IA --> N8n : { acciones: [answerCallbackQuery, sendMessage] }
deactivate IA
N8n -> Tg : sendMessage(chat, botones de turno)
deactivate N8n
Tg --> Est : muestra los turnos
deactivate Tg

loop al elegir el turno y luego el día
  Est -> Tg : pulsa una opción
  activate Tg
  N8n -> Tg : getUpdates(offset)
  activate N8n
  Tg --> N8n : update
  N8n -> IA : telegram_evento(update)
  activate IA
  IA -> IA : procesar_evento(update)
  IA -> Sql : chat(cid)
  activate Sql
  Sql --> IA : listo
  deactivate Sql
  IA -> IA : _elegir_dia(turno) o _elegir_plato(turno, fecha)
  IA -> McpM : consultar_menu(turno)
  activate McpM
  McpM -> Mongo : find({fecha: {$gte: inicio}, turno})
  activate Mongo
  Mongo --> McpM : menus
  deactivate Mongo
  McpM --> IA : menús con porciones disponibles
  deactivate McpM
  IA --> N8n : { acciones: [answerCallbackQuery, sendMessage] }
  deactivate IA
  N8n -> Tg : sendMessage(chat, botones de día o de plato)
  deactivate N8n
  Tg --> Est : muestra los días o los platos con cupo
  deactivate Tg
end

== Reservar (Saga 1): POST /agentes/telegram/evento ==

Est -> Tg : pulsa un plato
activate Tg
N8n -> Tg : getUpdates(offset)
activate N8n
Tg --> N8n : update
N8n -> IA : telegram_evento(update)
activate IA
IA -> IA : procesar_evento(update)
IA -> Sql : chat(cid)
activate Sql
Sql --> IA : listo
deactivate Sql
IA -> IA : _reservar(cid, chat, turno, fecha, plato)
IA -> McpM : consultar_menu(turno)
activate McpM
McpM -> Mongo : find({fecha: {$gte: inicio}, turno})
activate Mongo
Mongo --> McpM : menus
deactivate Mongo
McpM --> IA : menú con cupo
deactivate McpM
IA -> McpR : consultar_beca(estudianteId)
activate McpR
McpR -> PgRes : findOne({estudianteId, vigenteHasta: {$gte: hoy}})
activate PgRes
PgRes --> McpR : beca
deactivate PgRes
McpR --> IA : { tieneBeca, cubreHoy }
deactivate McpR

IA -> Saga : reservar_y_pagar(dto)
activate Saga
Saga -> Dynamo : check_and_lock_idempotency(key)
activate Dynamo
Dynamo --> Saga : clave nueva
deactivate Dynamo
Saga -> Dynamo : put_saga(sagaId, RUNNING)
activate Dynamo
deactivate Dynamo
Saga -> Res : crear(dto)
activate Res
Res -> Res : ReservarRacionUseCase.execute(dto)
Res -> PgRes : INSERT INTO reservas
activate PgRes
PgRes --> Res : reserva
deactivate PgRes
Res --> Saga : { id, estado: 'pendiente' }
deactivate Res
Saga -> Por : apartar(dto)
activate Por
Por -> Por : ApartarPorcionUseCase.ejecutar(dto)
Por -> Mongo : updateOne({menuId}, {$inc: {apartadas: 1}})
activate Mongo
Mongo --> Por : menu
deactivate Mongo
Por --> Saga : { ok: true }
deactivate Por

alt sin beca que cubra hoy
  Saga -> Pag : cobrar(dto, qr_bancario)
  activate Pag
  Pag -> Pag : CobrarRacionService.execute(dto)
  Pag -> Stripe : cobrarQr(monto, pagoId)
  activate Stripe
  Stripe --> Pag : { paymentUrl, referencia }
  deactivate Stripe
  Pag -> PgPag : INSERT INTO pagos, INSERT INTO tickets
  activate PgPag
  PgPag --> Pag : ok
  deactivate PgPag
  Pag --> Saga : { pagoId, ticketId, stripe }
  deactivate Pag
  Saga -> Dynamo : put_saga(sagaId, PENDING_PAYMENT)
  activate Dynamo
  deactivate Dynamo
  Saga --> IA : { status: PENDING_PAYMENT, reservaId, stripe }
  IA -> Sql : guardar_pago(reservaId, chat, referencia, plato, fecha, turno)
  activate Sql
  deactivate Sql
  IA -> N8n : POST /webhook/notificar-foto(chat, QR de pago)
  N8n -> Tg : sendPhoto(chat, QR de pago)
else beca que cubre hoy
  Saga -> Pag : cobrar(dto, beca)
  activate Pag
  Pag -> Pag : CobrarRacionService.execute(dto)
  Pag -> PgPag : INSERT INTO pagos, INSERT INTO tickets
  activate PgPag
  PgPag --> Pag : ok
  deactivate PgPag
  Pag --> Saga : { pagoId, ticketId }
  deactivate Pag
  Saga -> Res : confirmarR(reservaId)
  activate Res
  Res -> Res : ConfirmarReservaUseCase.execute(reservaId)
  Res -> PgRes : UPDATE reservas SET estado='confirmada'
  activate PgRes
  PgRes --> Res : reserva
  deactivate PgRes
  Res --> Saga : { reservaId, qr }
  deactivate Res
  Saga -> Dynamo : put_saga(sagaId, COMPLETED)
  activate Dynamo
  deactivate Dynamo
  Saga --> IA : { status: COMPLETED, reservaId, qr }
  IA -> N8n : POST /webhook/notificar-foto(chat, QR de ingreso)
  N8n -> Tg : sendPhoto(chat, QR de ingreso)
end
deactivate Saga

IA --> N8n : { acciones: [answerCallbackQuery, sendMessage] }
deactivate IA
N8n -> Tg : sendMessage(chat, reserva creada o confirmada)
deactivate N8n
Tg --> Est : muestra la reserva y su QR
deactivate Tg

== Pago y confirmación (hilo de MSIA, sin pasar por n8n) ==

Est -> Stripe : paga con el QR o el enlace
activate Stripe
Stripe --> Est : pago aprobado
deactivate Stripe

IA -> IA : bucle_pagos() (cada 8 segundos)
activate IA
IA -> Sql : pagos_en_curso()
activate Sql
Sql --> IA : pagos esperando confirmación
deactivate Sql
IA -> IA : _verificar_pago(reservaId)
IA -> Saga : confirmar_pago(reservaId, referencia)
activate Saga
Saga -> Pag : verificar(referencia)
activate Pag
Pag -> Stripe : verificarPago(referencia)
activate Stripe
Stripe --> Pag : { paid: true }
deactivate Stripe
Pag --> Saga : { paid: true }
deactivate Pag
Saga -> Res : confirmarR(reservaId)
activate Res
Res -> Res : ConfirmarReservaUseCase.execute(reservaId)
Res -> PgRes : UPDATE reservas SET estado='confirmada'
activate PgRes
PgRes --> Res : reserva
deactivate PgRes
Res --> Saga : { reservaId, qr }
deactivate Res
Saga --> IA : { confirmada: true, qr }
deactivate Saga
IA -> Sql : marcar_pago(reservaId, esperando_factura)
activate Sql
deactivate Sql
IA -> N8n : POST /webhook/notificar(telegram, pago recibido)
N8n -> Tg : sendMessage(chat, pago recibido)
IA -> N8n : POST /webhook/notificar-foto(chat, QR de ingreso)
N8n -> Tg : sendPhoto(chat, QR de ingreso)
IA -> IA : _enviar_factura(pago)
IA -> Pag : recibo(referencia)
activate Pag
Pag -> Stripe : facturaUrl(referencia)
activate Stripe
Stripe --> Pag : { url, tipo, pdf }
deactivate Stripe
Pag --> IA : { url, tipo, pdf }
deactivate Pag
IA -> N8n : POST /webhook/notificar(telegram, enlace de la factura)
N8n -> Tg : sendMessage(chat, enlace de la factura)
IA -> Sql : marcar_pago(reservaId, completado)
activate Sql
deactivate Sql
deactivate IA
Tg --> Est : muestra la confirmación, el QR de ingreso y la factura

@enduml
