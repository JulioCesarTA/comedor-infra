@startuml Secuencia_Validar_QR
title Diagrama de Secuencia - CU11: Validar QR de ingreso

hide footbox
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #2C6CA5
  ParticipantBorderColor #2C6CA5
  ParticipantBackgroundColor #E8F4FD
  ActorBorderColor #2C3E50
}

actor "Personal de Caja" as Caja
boundary "Vista\n(Backoffice)" as Vista
participant "Gateway\n(api-gw)" as GW
participant "Gateway\n(graphql-gw)" as GQL
participant "IngresoResolver\n(MSReservas)" as Res
database "BD Reservas\n(PostgreSQL)" as PgRes

== Endpoint: POST /graphql (mutation validarQr) ==

Caja -> Vista : startCamera()
activate Vista
Vista -> Vista : html5QrCode.start() lee el QR
Vista -> Vista : validar()
Vista -> GW : POST /graphql
activate GW
GW -> GW : requireAuth(token)
GW -> GQL : mutation validarQr(qr)
activate GQL
GQL -> Res : validarQr(qr)
activate Res
Res -> Res : ValidarIngresoUseCase.execute(qr)
Res -> PgRes : findOne({qrCode: qr})
activate PgRes
PgRes --> Res : reserva
deactivate PgRes
Res -> Res : reserva.marcarConsumida()
Res -> PgRes : UPDATE reservas SET estado='consumida'
activate PgRes
PgRes --> Res : reserva
deactivate PgRes
Res --> GQL : { ok: true, reservaId }
deactivate Res
GQL --> GW : { data: { validarQr } }
deactivate GQL
GW --> Vista : 200 OK
deactivate GW
Vista --> Caja : muestra "Ingreso autorizado"
deactivate Vista

@enduml
